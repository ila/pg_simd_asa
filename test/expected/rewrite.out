-- ... but a subquery's entity without an exposed key counts as one more
EXPLAIN (COSTS OFF, VERBOSE)
SELECT count(*) FROM (SELECT o_total FROM r_orders) o JOIN r_customer ON c_custkey = o.o_total;
                                                                                                   QUERY PLAN                                                                                                   
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   Output: asa_lane_mul(as_count((priv_hash(asa_hash(r_orders.o_custkey), '-2141240251835189051'::bigint) & priv_hash(asa_hash(r_customer.c_custkey), '-2141240251835189051'::bigint))), '2'::double precision)
   ->  Merge Join
         Output: r_orders.o_custkey, r_customer.c_custkey
         Merge Cond: (r_orders.o_total = r_customer.c_custkey)
         ->  Sort
               Output: r_orders.o_custkey, r_orders.o_total
               Sort Key: r_orders.o_total
               ->  Seq Scan on public.r_orders
                     Output: r_orders.o_custkey, r_orders.o_total
         ->  Sort
               Output: r_customer.c_custkey
               Sort Key: r_customer.c_custkey
               ->  Seq Scan on public.r_customer
                     Output: r_customer.c_custkey
(15 rows)

