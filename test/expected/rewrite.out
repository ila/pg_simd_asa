EXPLAIN (COSTS OFF, VERBOSE)
SELECT c_nation, sum(l_qty) FROM r_customer, r_orders, r_lineitem
WHERE c_custkey = o_custkey AND o_orderkey = l_orderkey GROUP BY 1;
                                                             QUERY PLAN                                                             
------------------------------------------------------------------------------------------------------------------------------------
 HashAggregate
   Output: r_customer.c_nation, as_sum(priv_hash(asa_hash(r_customer.c_custkey), '-2141240251835189051'::bigint), r_lineitem.l_qty)
   Group Key: r_customer.c_nation
   ->  Merge Join
         Output: r_customer.c_nation, r_customer.c_custkey, r_lineitem.l_qty
         Merge Cond: (r_lineitem.l_orderkey = r_orders.o_orderkey)
         ->  Sort
               Output: r_lineitem.l_qty, r_lineitem.l_orderkey
               Sort Key: r_lineitem.l_orderkey
               ->  Seq Scan on public.r_lineitem
                     Output: r_lineitem.l_qty, r_lineitem.l_orderkey
         ->  Sort
               Output: r_customer.c_nation, r_customer.c_custkey, r_orders.o_orderkey
               Sort Key: r_orders.o_orderkey
               ->  Merge Join
                     Output: r_customer.c_nation, r_customer.c_custkey, r_orders.o_orderkey
                     Merge Cond: (r_orders.o_custkey = r_customer.c_custkey)
                     ->  Sort
                           Output: r_orders.o_custkey, r_orders.o_orderkey
                           Sort Key: r_orders.o_custkey
                           ->  Seq Scan on public.r_orders
                                 Output: r_orders.o_custkey, r_orders.o_orderkey
                     ->  Sort
                           Output: r_customer.c_nation, r_customer.c_custkey
                           Sort Key: r_customer.c_custkey
                           ->  Seq Scan on public.r_customer
                                 Output: r_customer.c_nation, r_customer.c_custkey
