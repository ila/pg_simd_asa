-- ---------------------------------------------------------------------------
-- A comparison with an aggregating sub-select is a predicate over worlds (TPC-H Q17 shape):
-- the sub-select yields one value per world, and the comparison's per-world outcome is
-- folded into the mask of the outer aggregates.
-- ---------------------------------------------------------------------------
EXPLAIN (COSTS OFF, VERBOSE)
SELECT sum(l_price) FROM r_lineitem l1
WHERE l_qty < (SELECT avg(l_qty) FROM r_lineitem l2 WHERE l2.l_orderkey % 10 = l1.l_orderkey % 10);
                                                                                     QUERY PLAN                                                                                     
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   Output: as_sum((priv_hash(asa_hash(asa_r_orders.o_custkey), '-2141240251835189051'::bigint) & asa_lane_lt((l1.l_qty)::double precision, (SubPlan 1))), l1.l_price)
   ->  Merge Join
         Output: asa_r_orders.o_custkey, l1.l_qty, l1.l_orderkey, l1.l_price
         Merge Cond: (asa_r_orders.o_orderkey = l1.l_orderkey)
         ->  Sort
               Output: asa_r_orders.o_custkey, asa_r_orders.o_orderkey
               Sort Key: asa_r_orders.o_orderkey
               ->  Seq Scan on public.r_orders asa_r_orders
                     Output: asa_r_orders.o_custkey, asa_r_orders.o_orderkey
         ->  Sort
               Output: l1.l_qty, l1.l_orderkey, l1.l_price
               Sort Key: l1.l_orderkey
               ->  Seq Scan on public.r_lineitem l1
                     Output: l1.l_qty, l1.l_orderkey, l1.l_price
   SubPlan 1
     ->  Aggregate
           Output: asa_counters_avg(priv_hash(asa_hash(asa_r_orders_1.o_custkey), '-2141240251835189051'::bigint), l2.l_qty, '-2141240251835189051'::bigint, '1'::double precision)
           ->  Hash Join
                 Output: asa_r_orders_1.o_custkey, l2.l_qty
                 Hash Cond: (asa_r_orders_1.o_orderkey = l2.l_orderkey)
                 ->  Seq Scan on public.r_orders asa_r_orders_1
                       Output: asa_r_orders_1.o_orderkey, asa_r_orders_1.o_custkey, asa_r_orders_1.o_total
                 ->  Hash
                       Output: l2.l_qty, l2.l_orderkey
                       ->  Seq Scan on public.r_lineitem l2
                             Output: l2.l_qty, l2.l_orderkey
                             Filter: ((l2.l_orderkey % '10'::bigint) = (l1.l_orderkey % '10'::bigint))
(28 rows)

CREATE TEMP TABLE rw AS SELECT sum(l_price) AS s FROM r_lineitem l1
WHERE l_qty < (SELECT avg(l_qty) FROM r_lineitem l2 WHERE l2.l_orderkey % 10 = l1.l_orderkey % 10);
-- the definition: the query evaluated on each world alone (as_sum reports 2 x sum)
SET simd_asa.rewrite = off;
CREATE TEMP TABLE def AS
WITH li AS (SELECT l.*, priv_hash(asa_hash(o_custkey)) AS m FROM r_lineitem l JOIN r_orders ON l_orderkey = o_orderkey),
     w AS (SELECT j, li.* FROM li, generate_series(0, 63) j WHERE (m >> j) & 1 = 1),
     a AS (SELECT j, l_orderkey % 10 AS g, avg(l_qty) AS avg_qty FROM w GROUP BY 1, 2)
SELECT w.j, 2 * sum(l_price) AS s FROM w JOIN a ON a.j = w.j AND a.g = w.l_orderkey % 10
WHERE l_qty < avg_qty GROUP BY w.j;
SELECT count(*) AS worlds, count(*) FILTER (WHERE abs(r.v - d.s) > 1e-4 * abs(d.s)) AS worlds_differing
FROM (SELECT ordinality - 1 AS j, v FROM rw, unnest(rw.s) WITH ORDINALITY u(v, ordinality)) r JOIN def d USING (j);
 worlds | worlds_differing 
--------+------------------
     64 |                0
(1 row)

DROP TABLE rw, def;
SET simd_asa.rewrite = on;
-- outer rows that are shared by all worlds: the predicate alone decides the worlds
EXPLAIN (COSTS OFF, VERBOSE) SELECT count(*) FROM r_nation WHERE n_key < (SELECT avg(c_nation) FROM r_customer);
                                                                                        QUERY PLAN                                                                                         
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Aggregate
   Output: as_count(asa_lane_lt((r_nation.n_key)::double precision, $0))
   InitPlan 1 (returns $0)
     ->  Aggregate
           Output: asa_counters_avg(priv_hash(asa_hash(r_customer.c_custkey), '-2141240251835189051'::bigint), r_customer.c_nation, '-2141240251835189051'::bigint, '1'::double precision)
